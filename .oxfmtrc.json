{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "trailingComma": "none",
  "singleQuote": true,
  "jsxSingleQuote": true,
  "printWidth": 90,
  "tabWidth": 2,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents",
    "node_modules",
    ".DS_Store",
    "docs",
    "*.local",
    "node_modules/*",
    ".next",
    "next-env.d.ts"
  ]
}
